//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Order Flow · CVD  (Cumulative Delta · Divergence · Absorption)
// ═══════════════════════════════════════════════════════════════════════════
//  Pane companion to orderflow_footprint.pine — same intrabar classification
//  engine, but instead of drawing a per-bar ladder it tracks the delta series:
//
//    · CVD plotted as candles (open = CVD at bar open, high/low = the running
//      delta's intrabar extremes, close = CVD at bar close) — the same read
//      you get from a Sierra/ATAS cumulative-delta chart.
//    · Price↔CVD divergence at confirmed pivots (effort disagreeing with result).
//    · Absorption: heavy one-sided delta that fails to move price.
//    · Exhaustion: a wide-range bar produced on almost no net delta.
//
//  Delta here is INFERRED from intrabar OHLCV, not from a real aggressor tape.
//  Read pinescript/README.md before trading off the absolute numbers.
// ═══════════════════════════════════════════════════════════════════════════

indicator("Order Flow · CVD", "OF CVD", overlay = false,
     max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────────────────────────────────────── inputs ────
G_ENG = "① Data engine"
G_DSP = "② Display"
G_DIV = "③ Divergence"
G_ABS = "④ Absorption / exhaustion"
G_COL = "⑤ Colours"

ltfMode = input.string("Auto", "Intrabar resolution", options = ["Auto", "Manual"], group = G_ENG)
ltfMan  = input.timeframe("1", "    ↳ manual", group = G_ENG)
clsMode = input.string("Tick rule", "Buy/sell classification", group = G_ENG,
     options = ["Tick rule", "Bar polarity", "Proportional"])
resetOn = input.string("Session", "Reset CVD", options = ["Never", "Session", "Week"], group = G_ENG)

dispMode = input.string("CVD candles", "Plot", options = ["CVD candles", "CVD line", "Bar delta histogram"], group = G_DSP)
showMA   = input.bool(true, "CVD moving average", group = G_DSP)
maLen    = input.int(21, "    ↳ length", minval = 2, group = G_DSP)
showTbl  = input.bool(true, "Stats table", group = G_DSP)

divOn   = input.bool(true, "Price ↔ CVD divergence", group = G_DIV)
pvLen   = input.int(5, "    ↳ pivot lookback / lookforward", minval = 2, maxval = 20, group = G_DIV)
divLine = input.bool(true, "    ↳ draw connecting lines", group = G_DIV)

absOn     = input.bool(true, "Absorption", group = G_ABS,
     tooltip = "Delta in the top percentile of recent bars while price refuses to follow — " +
     "a passive limit book eating the aggressors.")
absLook   = input.int(100, "    ↳ percentile lookback", minval = 20, group = G_ABS)
absPct    = input.int(85, "    ↳ delta percentile", minval = 50, maxval = 99, group = G_ABS)
absBody   = input.float(0.35, "    ↳ max body / range", minval = 0.05, maxval = 1.0, step = 0.05, group = G_ABS)
exhOn     = input.bool(true, "Exhaustion (range without delta)", group = G_ABS)
exhDeltaP = input.int(25, "    ↳ delta percentile below", minval = 5, maxval = 60, group = G_ABS)

cBull = input.color(#26a69a, "Buy / up", group = G_COL)
cBear = input.color(#ef5350, "Sell / down", group = G_COL)
cMA   = input.color(#ffb300, "MA", group = G_COL)
cDiv  = input.color(#e040fb, "Divergence", group = G_COL)

// ───────────────────────────────────────────────── lower-timeframe feed ────
_tfs    = timeframe.in_seconds(timeframe.period)
autoLtf = _tfs <= 60 ? "1S" : _tfs <= 300 ? "5S" : _tfs <= 900 ? "15S" : _tfs <= 3600 ? "1" : _tfs <= 14400 ? "5" : _tfs <= 86400 ? "15" : "60"
ltf     = ltfMode == "Auto" ? autoLtf : ltfMan

aO = request.security_lower_tf(syminfo.tickerid, ltf, open,   true)
aH = request.security_lower_tf(syminfo.tickerid, ltf, high,   true)
aL = request.security_lower_tf(syminfo.tickerid, ltf, low,    true)
aC = request.security_lower_tf(syminfo.tickerid, ltf, close,  true)
aV = request.security_lower_tf(syminfo.tickerid, ltf, volume, true)

f_num(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : a >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : a >= 1000 ? str.tostring(v / 1000, "#.#") + "K" : str.tostring(math.round(v), "#")

// ───────────────────────────────────────────── intrabar classification ─────
var float prevC   = na
var int   lastDir = 1

float bBuy  = 0.0
float bSell = 0.0
float runD  = 0.0
float maxD  = 0.0
float minD  = 0.0

nIB = array.size(aV)

if nIB > 0
    for i = 0 to nIB - 1
        float c = array.get(aC, i)
        float o = array.get(aO, i)
        float h = array.get(aH, i)
        float l = array.get(aL, i)
        float v = array.get(aV, i)
        if not na(v) and v > 0 and not na(c)
            float buy  = 0.0
            float sell = 0.0
            if clsMode == "Tick rule"
                int d = na(prevC) ? (c >= o ? 1 : -1) : c > prevC ? 1 : c < prevC ? -1 : lastDir
                lastDir := d
                buy  := d > 0 ? v : 0.0
                sell := d > 0 ? 0.0 : v
            else if clsMode == "Bar polarity"
                buy  := c > o ? v : c < o ? 0.0 : v * 0.5
                sell := v - buy
            else
                float rr = h - l
                float f  = rr > 0 ? (c - l) / rr : (c >= o ? 1.0 : 0.0)
                buy  := v * f
                sell := v - buy
            prevC := c
            bBuy  += buy
            bSell += sell
            runD  += buy - sell
            maxD  := math.max(maxD, runD)
            minD  := math.min(minD, runD)

if nIB == 0 and volume > 0
    float rr = high - low
    float f  = rr > 0 ? (close - low) / rr : 0.5
    bBuy  := volume * f
    bSell := volume - bBuy
    runD  := bBuy - bSell
    maxD  := math.max(0, runD)
    minD  := math.min(0, runD)

barDelta = bBuy - bSell
barVol   = bBuy + bSell

// ─────────────────────────────────────────────────────────── cvd series ────
var float cvd = 0.0
bool doReset = resetOn == "Session" ? timeframe.change("D") : resetOn == "Week" ? timeframe.change("W") : false
if doReset
    cvd := 0.0

cvdO = cvd
cvdH = cvd + maxD
cvdL = cvd + minD
cvd += barDelta
cvdC = cvd

cvdMA = ta.sma(cvdC, maLen)

// ───────────────────────────────────────────────────────────── plotting ────
upBar = cvdC >= cvdO
plotcandle(dispMode == "CVD candles" ? cvdO : na, dispMode == "CVD candles" ? cvdH : na,
     dispMode == "CVD candles" ? cvdL : na, dispMode == "CVD candles" ? cvdC : na,
     title = "CVD", color = upBar ? cBull : cBear, wickcolor = upBar ? cBull : cBear,
     bordercolor = upBar ? cBull : cBear)
plot(dispMode == "CVD line" ? cvdC : na, "CVD line", color = upBar ? cBull : cBear, linewidth = 2)
plot(dispMode == "Bar delta histogram" ? barDelta : na, "Bar delta", style = plot.style_columns,
     color = barDelta >= 0 ? color.new(cBull, 25) : color.new(cBear, 25))
plot(showMA and dispMode != "Bar delta histogram" ? cvdMA : na, "CVD MA", color = cMA)
hline(0, "Zero", color = color.new(color.gray, 50), linestyle = hline.style_dotted)

// ────────────────────────────────────────────────────────── divergence ─────
ph = ta.pivothigh(high, pvLen, pvLen)
pl = ta.pivotlow(low, pvLen, pvLen)

var float lastPHp = na      // price at last pivot high
var float lastPHc = na      // cvd at that pivot
var int   lastPHb = na
var float lastPLp = na
var float lastPLc = na
var int   lastPLb = na

bool bearDiv = false
bool bullDiv = false

if divOn and not na(ph)
    float cAt = cvdC[pvLen]
    int   bAt = bar_index - pvLen
    if not na(lastPHp) and ph > lastPHp and cAt < lastPHc
        bearDiv := true
        if barstate.isconfirmed
            label.new(bAt, cAt, "▼ div", xloc = xloc.bar_index, style = label.style_label_down,
                 color = color.new(cDiv, 20), textcolor = color.white, size = size.tiny)
            if divLine
                line.new(lastPHb, lastPHc, bAt, cAt, xloc = xloc.bar_index, color = cDiv, width = 1,
                     style = line.style_dashed)
    lastPHp := ph
    lastPHc := cAt
    lastPHb := bAt

if divOn and not na(pl)
    float cAt = cvdC[pvLen]
    int   bAt = bar_index - pvLen
    if not na(lastPLp) and pl < lastPLp and cAt > lastPLc
        bullDiv := true
        if barstate.isconfirmed
            label.new(bAt, cAt, "▲ div", xloc = xloc.bar_index, style = label.style_label_up,
                 color = color.new(cDiv, 20), textcolor = color.white, size = size.tiny)
            if divLine
                line.new(lastPLb, lastPLc, bAt, cAt, xloc = xloc.bar_index, color = cDiv, width = 1,
                     style = line.style_dashed)
    lastPLp := pl
    lastPLc := cAt
    lastPLb := bAt

// ────────────────────────────────────────────── absorption / exhaustion ────
absD    = math.abs(barDelta)
hiDelta = ta.percentile_nearest_rank(absD, absLook, absPct)
loDelta = ta.percentile_nearest_rank(absD, absLook, exhDeltaP)
rng     = high - low
bodyFr  = rng > 0 ? math.abs(close - open) / rng : 1.0
atr14   = ta.atr(14)

absorbBuy  = absOn and barDelta > 0 and absD >= hiDelta and (bodyFr <= absBody or close <= open)   // buyers absorbed → bearish
absorbSell = absOn and barDelta < 0 and absD >= hiDelta and (bodyFr <= absBody or close >= open)   // sellers absorbed → bullish
exhaust    = exhOn and rng >= atr14 * 1.2 and absD <= loDelta

if barstate.isconfirmed and absorbBuy
    label.new(bar_index, cvdH, "ABS", xloc = xloc.bar_index, style = label.style_label_down,
         color = color.new(cBear, 25), textcolor = color.white, size = size.tiny,
         tooltip = "Heavy buy delta absorbed — no upside result")
if barstate.isconfirmed and absorbSell
    label.new(bar_index, cvdL, "ABS", xloc = xloc.bar_index, style = label.style_label_up,
         color = color.new(cBull, 25), textcolor = color.white, size = size.tiny,
         tooltip = "Heavy sell delta absorbed — no downside result")
if barstate.isconfirmed and exhaust
    label.new(bar_index, cvdC, "×", xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny,
         tooltip = "Wide range on negligible net delta — move is not being paid for")

bgcolor(absorbBuy ? color.new(cBear, 88) : absorbSell ? color.new(cBull, 88) : na)

// ─────────────────────────────────────────────────────────────── table ─────
var float sessBuy  = 0.0
var float sessSell = 0.0
if timeframe.change("D")
    sessBuy  := 0.0
    sessSell := 0.0
sessBuy  += bBuy
sessSell += bSell

var table t = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20),
     border_color = color.new(color.gray, 60), border_width = 1,
     frame_color = color.new(color.gray, 40), frame_width = 1)

f_cell(int row, string k, string v, color vc) =>
    table.cell(t, 0, row, k, text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, row, v, text_color = vc, text_size = size.tiny, text_halign = text.align_right)

sessD = sessBuy - sessSell
if barstate.islast and showTbl
    f_cell(0, "intrabar TF", nIB > 0 ? ltf + "  (" + str.tostring(nIB) + ")" : "NO DATA", nIB > 0 ? color.silver : cBear)
    f_cell(1, "bar Δ", (barDelta >= 0 ? "+" : "−") + f_num(math.abs(barDelta)), barDelta >= 0 ? cBull : cBear)
    f_cell(2, "Δ / volume", barVol > 0 ? str.tostring(barDelta / barVol * 100, "#.#") + " %" : "—", barDelta >= 0 ? cBull : cBear)
    f_cell(3, "Δ max / min", "+" + f_num(maxD) + " / −" + f_num(math.abs(minD)), color.silver)
    f_cell(4, "CVD", (cvdC >= 0 ? "+" : "−") + f_num(math.abs(cvdC)), cvdC >= 0 ? cBull : cBear)
    f_cell(5, "session Δ", (sessD >= 0 ? "+" : "−") + f_num(math.abs(sessD)), sessD >= 0 ? cBull : cBear)
    f_cell(6, "buy % of vol", barVol > 0 ? str.tostring(bBuy / barVol * 100, "#.#") + " %" : "—", color.silver)

// ────────────────────────────────────────────────────────────── alerts ─────
alertcondition(bearDiv,    "Bearish CVD divergence", "Order flow: {{ticker}} price HH with CVD LH on {{interval}}")
alertcondition(bullDiv,    "Bullish CVD divergence", "Order flow: {{ticker}} price LL with CVD HL on {{interval}}")
alertcondition(absorbBuy,  "Buy absorption",         "Order flow: {{ticker}} buy delta absorbed on {{interval}}")
alertcondition(absorbSell, "Sell absorption",        "Order flow: {{ticker}} sell delta absorbed on {{interval}}")
alertcondition(ta.cross(cvdC, 0), "CVD zero cross",  "Order flow: {{ticker}} CVD crossed zero on {{interval}}")
